    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Step 1: Ensure the job_queue table exists\nCREATE TABLE IF NOT EXISTS job_queue (\n  id SERIAL PRIMARY KEY,\n  card_id TEXT UNIQUE NOT NULL,          -- Trello card ID\n  card_name TEXT,                        -- Card title\n  card_desc TEXT,                        -- Card description (\"desc\")\n  board_id TEXT,                         -- Board ID\n  board_name TEXT,                       -- Board name\n  list_id TEXT,                          -- List ID\n  status TEXT DEFAULT 'pending',         -- pending / processing / done / error / skipped\n  err_code TEXT DEFAULT NULL,            -- e.g. DUPLICATE_INSERT, RETRY, MANUAL_SKIP\n  source_event TEXT DEFAULT NULL,        -- Trello webhook action type (e.g. createCard, updateCard)\n  created_at TIMESTAMP DEFAULT NOW(),\n  updated_at TIMESTAMP DEFAULT NOW()\n);\n\n-- Step 2: Insert or update intelligently\nINSERT INTO job_queue (\n  card_id,\n  card_name,\n  card_desc,\n  board_id,\n  board_name,\n  list_id,\n  status,\n  source_event\n)\nVALUES (\n  '{{$json.action.data.card.id}}',\n  '{{$json.action.data.card.name}}',\n  '{{$json.action.data.card.desc}}',\n  '{{$json.action.data.board.id}}',\n  '{{$json.action.data.board.name}}',\n  '{{$json.action.data.list.id}}',\n  'pending',\n  '{{$json.action.type}}'\n)\nON CONFLICT (card_id)\nDO UPDATE\nSET\n  card_name = EXCLUDED.card_name,\n  card_desc = EXCLUDED.card_desc,\n  board_id = EXCLUDED.board_id,\n  board_name = EXCLUDED.board_name,\n  list_id = EXCLUDED.list_id,\n  source_event = EXCLUDED.source_event,\n  updated_at = NOW(),\n  err_code = 'DUPLICATE_INSERT';\n",
        "options": {}
      },
