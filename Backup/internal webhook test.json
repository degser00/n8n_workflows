      "parameters": {
        "jsCode": "// Access the webhook payload\nconst payload = $input.all()[0].json;\n\n// Safely process the data with checks\nconst processed = {\n  id: payload.card_id || 'unknown',\n  title: (payload.card_name || 'Untitled').toUpperCase(),\n  received_at: new Date().toISOString(),\n  is_urgent: payload.card_name ? payload.card_name.toLowerCase().includes('urgent') : false,\n  source: 'internal_webhook'\n};\n\n// Log it (visible in execution logs)\nconsole.log('Processed webhook data:', processed);\n\n// Return the processed data to the next node\nreturn [{ json: processed }];"
